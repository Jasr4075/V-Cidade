# Supabase Local (run: supabase start)
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Or use external PostgreSQL
# DATABASE_URL=postgresql://user:password@host:port/database

# These two files are LOCAL-ONLY. For cloud builds the same variables live in
# EAS (`eas env:set --environment production`) and are injected at build time,
# because EAS servers never see .env files.
#
#   .env.local             → dev against the local Supabase stack (supabase start)
#   .env.production.local  → this machine, when bundling locally with
#                            NODE_ENV=production (e.g. `npx expo export`)
#
# Only the publishable key belongs in the app. The secret key (sb_secret_...)
# is the equivalent of service_role: it bypasses RLS and must never be placed
# in an EXPO_PUBLIC_* variable, since those are inlined in plain text into the
# bundle and are readable by anyone with the app.
#
# The Supabase Cloud URL is not loopback, so src/services/supabase.ts uses it
# verbatim, skipping the Metro-host resolution that exists for the local stack.

# Google Maps (required for Android builds — Expo Go on SDK 55+ ships an
# expired Maps key and renders a black map).
# Create a key at https://console.cloud.google.com/apis/credentials with
# "Maps SDK for Android" enabled and restricted to the Android package below.
GOOGLE_MAPS_API_KEY=your-android-key-here
# Optional: needed only if you set provider={PROVIDER_GOOGLE} on iOS.
GOOGLE_MAPS_IOS_API_KEY=your-ios-key-here